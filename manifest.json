{
  "manifest_version": 3,
  "name": "Watch Later Manager for YouTube\u2122",
  "version": "0.1.3",
  "description": "Clean up YouTube Watch Later faster with checkboxes, batch remove, and watched-first sorting.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/playlist*",
        "https://youtube.com/playlist*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
